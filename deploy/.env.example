# Set a random one-time key before opening the site for first setup.
# Remove it after the first administrator account has been created.
ILMEK_SETUP_TOKEN=

# Google Drive cloud backup is optional. Leave these blank until OAuth is configured.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
